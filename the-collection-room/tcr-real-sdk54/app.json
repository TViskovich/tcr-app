{
  "expo": {
    "name": "CacheCase",
    "slug": "cachecase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/cachecase-app-icon.png",
    "scheme": "cachecase",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cachecase",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CacheCase to access your photos so you can add images to your collection.",
          "cameraPermission": "Allow CacheCase to use your camera so you can take photos for your collection."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/cachecase-primary.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bac96d01-6856-45a1-8a0c-a355bb14bc2e"
      }
    },
    "owner": "tvisko"
  }
}
