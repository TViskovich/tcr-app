# Base URL of the Supabase Functions namespace for the CacheCase project
# (NOT the function's full URL — the function name is appended in code,
# see lib/registry-api.ts). Safe to expose to the browser: it is just a
# routing target, the same way EXPO_PUBLIC_SUPABASE_URL is public in the
# Expo app. No key, token, or credential belongs in this file.
#
# Example: https://izlrxenomerfeqhmlyre.supabase.co/functions/v1
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=
