# Copy this file to .env and fill in your Supabase project values.
# Find these in: Supabase Dashboard → your project → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public CacheCase Registry base URL (see lib/registry-links.ts) — used to
# build the URL encoded in each registered card's QR code. No production
# registry website exists yet; set this to any placeholder domain for local
# QR testing, or leave unset to show the "unavailable" state.
EXPO_PUBLIC_CACHECASE_BASE_URL=https://cachecase.app
