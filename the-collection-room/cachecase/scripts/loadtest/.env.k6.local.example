# Copy to scripts/loadtest/.env.k6.local (git-ignored) for k6-read-workload.js.
# k6 reads ONLY this file, and refuses to start if it contains any setting
# other than the ones below. Never put the service-role key here.

# Exactly the staging project (production is rejected).
STAGING_SUPABASE_URL=https://ickqkzvqddkhqyxnbzox.supabase.co
# Staging's public anon (or sb_publishable_) key.
STAGING_SUPABASE_ANON_KEY=

# Synthetic accounts lt-user-NN@<domain>; same values as .env.staging.local.
LOADTEST_EMAIL_DOMAIN=
LOADTEST_USER_PASSWORD=
# Optional: only if lt_user_01's password differs.
# LOADTEST_USER_01_PASSWORD=
