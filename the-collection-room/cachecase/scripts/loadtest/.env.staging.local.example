# Copy to scripts/loadtest/.env.staging.local (git-ignored) and fill in.
# Used only by scripts/loadtest/*.ts — never by the app. Do NOT use
# EXPO_PUBLIC_ names here: those are bundled into the app.

# Staging only (Dashboard → ickqkzvqddkhqyxnbzox → Project Settings → API).
# The script refuses any other project, and production outright.
STAGING_SUPABASE_URL=https://ickqkzvqddkhqyxnbzox.supabase.co
STAGING_SUPABASE_SERVICE_ROLE_KEY=
# Public anon (or sb_publishable_) key — used by smoke-user-access.ts, which
# signs in as the synthetic users and never reads the service-role key.
STAGING_SUPABASE_ANON_KEY=

# A domain you control with no real mailboxes behind these addresses.
# Accounts are created as lt-user-01@<this domain> … lt-user-30@<this domain>.
LOADTEST_EMAIL_DOMAIN=

# Password for every NEW synthetic account (12+ characters). Existing
# accounts keep their password. Never logged.
LOADTEST_USER_PASSWORD=
# Optional: only if lt_user_01 was created with a different password.
# LOADTEST_USER_01_PASSWORD=
